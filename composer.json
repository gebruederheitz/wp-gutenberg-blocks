{
    "name": "gebruederheitz/wp-gutenberg-blocks",
    "description": "Helps you get your blocks on the road",
    "type": "library",
    "license": "GPL-3.0-only",
    "autoload": {
        "psr-4": {
            "Gebruederheitz\\GutenbergBlocks\\": "Gebruederheitz/GutenbergBlocks/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gebruederheitz\\GutenbergBlocks\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Andreas Maros",
            "email": "andreas.maros@gebruederheitz.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/yaml": "^v7.4.14",
        "gebruederheitz/simple-singleton": "^1.0"
    },
    "scripts": {
        "lint": "phpstan --memory-limit=2G analyse -c .phpstan.neon",
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2.2",
        "szepeviktor/phpstan-wordpress": "^v2.0.3",
        "wecodemore/wpstarter": "~3.0.1",
        "johnpbloch/wordpress-core-installer": "^2.0",
        "johnpbloch/wordpress-core": "7.0.*@stable"
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true,
            "wecodemore/wpstarter": true
        }
    },
    "extra": {
        "wordpress-content-dir": ".wp/wordpress/wp-content",
        "wordpress-install-dir": ".wp/wordpress"
    }
}
